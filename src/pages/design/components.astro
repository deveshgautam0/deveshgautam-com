---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Pagination from '../../components/Pagination.astro';
import TableOfContents from '../../components/TableOfContents.astro';
import ShareLinks from '../../components/ShareLinks.astro';
import Chip from '../../components/Chip.astro';
---
<BaseLayout title="Components" description="Component gallery" noindex>
  <div class="container">
    <h1 id="components" style="margin-bottom:var(--space-4);">Components</h1>
    <p style="color:var(--text-muted);margin-bottom:var(--space-6);">Chip, Pagination, TableOfContents and ShareLinks.</p>
    <section style="margin-bottom:var(--space-8);">
      <h2 id="chip">Chip</h2>
      <div style="display:flex;flex-wrap:wrap;gap:var(--space-2);">
        <Chip text="notes" href="/blog/categories/notes/" />
        <Chip text="#astro" href="/blog/tags/astro/" />
        <Chip text="plain chip" />
      </div>
    </section>
    <section style="margin-bottom:var(--space-8);">
      <h2 id="pagination">Pagination</h2>
      <Pagination base="/blog/" currentPage={1} lastPage={1} start={1} end={3} total={3} />
    </section>
    <section style="margin-bottom:var(--space-8);">
      <h2 id="table-of-contents">Table of contents</h2>
      <TableOfContents headings={[
        { depth: 2, slug: 'chip', text: 'Chip' },
        { depth: 2, slug: 'pagination', text: 'Pagination' },
        { depth: 2, slug: 'table-of-contents', text: 'Table of contents' },
        { depth: 2, slug: 'share-links', text: 'Share links' },
      ]} />
    </section>
    <section style="margin-bottom:var(--space-8);">
      <h2 id="share-links">Share links</h2>
      <ShareLinks url="https://deveshgautam.com/blog/sample/" title="Sample post" />
    </section>
  </div>
</BaseLayout>
