---
import BaseLayout from '../../layouts/BaseLayout.astro';
---
<BaseLayout title="Colors" description="Design tokens color reference" noindex>
  <div class="container">
    <h1 style="margin-bottom:var(--space-4);">Colors</h1>
    <p style="color:var(--text-muted);margin-bottom:var(--space-6);">Every design token, shown in light theme (toggle the theme switch in the header to see dark mode).</p>
    <div style="display:grid;grid-template-columns:repeat(auto-fill,minmax(220px,1fr));gap:var(--space-4);">
      {[
        ['--bg', 'var(--bg)'], ['--bg-soft', 'var(--bg-soft)'], ['--card', 'var(--card)'],
        ['--text', 'var(--text)'], ['--text-muted', 'var(--text-muted)'], ['--border', 'var(--border)'],
        ['--accent', 'var(--accent)'], ['--accent-hover', 'var(--accent-hover)'], ['--accent-soft', 'var(--accent-soft)'],
        ['--on-accent', 'var(--on-accent)'], ['--code-bg', 'var(--code-bg)'], ['--success', 'var(--success)'],
        ['--danger', 'var(--danger)'], ['--focus', 'var(--focus)']
      ].map(([name, value]) => (
        <div style="border:1px solid var(--border);border-radius:var(--radius);padding:var(--space-4);display:flex;flex-direction:column;gap:var(--space-2);">
          <div style="width:100%;height:40px;border-radius:var(--radius-sm);background-color:{value};border:1px solid var(--border);"></div>
          <code style="font-size:13px;">{name}</code>
          <span style="font-size:13px;color:var(--text-muted);">{value}</span>
        </div>
      ))}
    </div>
  </div>
</BaseLayout>
