---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PostCard from '../../components/PostCard.astro';
import PostListItem from '../../components/PostListItem.astro';
import ProjectCard from '../../components/ProjectCard.astro';
import { getPosts, getProjects } from '../../lib/content.ts';
const posts = await getPosts();
const projects = await getProjects();
---
<BaseLayout title="Cards" description="Card components: PostCard, PostListItem, ProjectCard" noindex>
  <div class="container">
    <h1 style="margin-bottom:var(--space-4);">Cards</h1>
    <p style="color:var(--text-muted);margin-bottom:var(--space-6);">PostCard (large), PostListItem (compact) and ProjectCard rendered with sample data.</p>
    <section style="margin-bottom:var(--space-8);">
      <h2 style="font-size:20px;margin:0 0 var(--space-4) 0;">PostCard</h2>
      {posts.slice(0, 1).map((p) => <PostCard post={p} />)}
    </section>
    <section style="margin-bottom:var(--space-8);">
      <h2 style="font-size:20px;margin:0 0 var(--space-4) 0;">PostListItem</h2>
      <div style="display:flex;flex-direction:column;gap:var(--space-4);">
        {posts.slice(0, 2).map((p) => <PostListItem post={p} />)}
      </div>
    </section>
    <section style="margin-bottom:var(--space-8);">
      <h2 style="font-size:20px;margin:0 0 var(--space-4) 0;">ProjectCard</h2>
      {projects.slice(0, 1).map((p) => <ProjectCard project={p} />)}
    </section>
  </div>
</BaseLayout>
