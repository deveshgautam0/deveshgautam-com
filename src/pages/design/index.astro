---
import BaseLayout from '../../layouts/BaseLayout.astro';
---
<BaseLayout title="Design system" description="Design system reference" noindex>
  <div class="container">
    <h1 style="margin-bottom:var(--space-4);">Design system</h1>
    <p style="color:var(--text-muted);margin-bottom:var(--space-6);">Reference pages for the site's design system.</p>
    <ul style="list-style:none;padding:0;margin:0;display:flex;flex-direction:column;gap:var(--space-3);">
      <li><a href="/design/cards/" style="color:var(--accent);">Cards</a></li>
      <li><a href="/design/buttons/" style="color:var(--accent);">Buttons</a></li>
      <li><a href="/design/colors/" style="color:var(--accent);">Colors</a></li>
      <li><a href="/design/images/" style="color:var(--accent);">Images</a></li>
      <li><a href="/design/embeds/" style="color:var(--accent);">Embeds</a></li>
      <li><a href="/design/components/" style="color:var(--accent);">Components</a></li>
      <li><a href="/design/typography/" style="color:var(--accent);">Typography</a></li>
    </ul>
  </div>
</BaseLayout>
