---
import BaseLayout from '../../../../layouts/BaseLayout.astro';
import PostCard from '../../../../components/PostCard.astro';
import Pagination from '../../../../components/Pagination.astro';
import PageTitle from '../../../../components/PageTitle.astro';
import { getPosts } from '../../../../lib/content.ts';
export async function getStaticPaths({ paginate }) {
  const posts = await getPosts();
  const categories = [...new Set(posts.map((p) => p.data.category))];
  return categories.flatMap((category) =>
    paginate(posts.filter((p) => p.data.category === category), { params: { category }, pageSize: 3 })
  );
}
const { category } = Astro.params;
const { page } = Astro.props;
---
<BaseLayout title={`Category: ${category}`} description={`Posts in the ${category} category.`}>
  <div class="container">
    <div class="prose-column">
      <PageTitle title={`Category: ${category}`} description={`Posts in the ${category} category.`} />
      {page.data.map((post) => <PostCard post={post} />)}
      <Pagination base={`/blog/categories/${category}/`} currentPage={page.currentPage} lastPage={page.lastPage} start={page.start + 1} end={page.end + 1} total={page.total} />
    </div>
  </div>
</BaseLayout>
