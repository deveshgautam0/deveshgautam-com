---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { render } from 'astro:content';
import { getProjects } from '../../lib/content.ts';
import ShareLinks from '../../components/ShareLinks.astro';
export async function getStaticPaths() {
  const projects = await getProjects();
  return projects.map((p) => ({ params: { id: p.id }, props: { project: p } }));
}
const { project } = Astro.props;
const { Content } = await render(project);
const { data } = project;
---
<BaseLayout title={data.title} description={data.description} image={data.heroImage} type="article">
  <article class="prose-column">
    <img src={data.heroImage || '/og-default.png'} alt={data.heroAlt || data.title} class="hero-image" loading="lazy" width="1600" height="900" />
    <h1>{data.title}</h1>
    <p style="color:var(--text-muted);margin:0 0 var(--space-3) 0;">{data.description}</p>
    <time style="font-size:14px;color:var(--text-muted);">{data.date.toLocaleDateString('en-US', { month: 'short', day: '2-digit', year: 'numeric' })}</time>
    <div class="prose"><Content /></div>
    <div style="display:flex;gap:var(--space-3);flex-wrap:wrap;margin:var(--space-6) 0 0 0;">
      {data.demoUrl && <a href={data.demoUrl} class="btn-primary">Demo</a>}
      {data.repoUrl && <a href={data.repoUrl} class="btn-outline">Repository</a>}
    </div>
    <ShareLinks url={new URL(`/projects/${project.id}/`, Astro.site).href} title={data.title} />
  </article>
</BaseLayout>
