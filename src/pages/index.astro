---
import BaseLayout from '../layouts/BaseLayout.astro';
import Icon from '../components/Icon.astro';
import site from '../data/site.json';
---
<BaseLayout title="Home" description="Welcome to my blog" image={site.heroImage}>
  <div class="container home-content" style="max-width:760px;margin:0 auto;padding-bottom:var(--space-11);">
    {site.heroImage && <img src={site.heroImage} alt={site.heroTitle} class="hero-image" loading="lazy" width="1600" height="900" style="margin-bottom:var(--space-8);" />}
    <h1>{site.heroTitle}</h1>
    <p>{site.heroText}</p>
    <div class="btn-row">
      <a href="/blog/" class="btn btn-primary">Read the blog<Icon name="arrow-right" size="18" /></a>
      <a href="/projects/" class="btn btn-outline">See projects</a>
    </div>
  </div>
</BaseLayout>
