---
import BaseLayout from '../layouts/BaseLayout.astro';
import site from '../data/site.json';
---
<BaseLayout title="Home" description="Welcome to my blog" image={site.heroImage}>
  <div class="container" style="max-width:760px;margin:0 auto;">
    {site.heroImage && <img src={site.heroImage} alt={site.heroTitle} class="hero-image" loading="lazy" width="1600" height="900" />}
    <h1>{site.heroTitle}</h1>
    <p>{site.heroText}</p>
    <div style="display:flex;gap:var(--space-3);flex-wrap:wrap;margin-top:var(--space-6);">
      <a href="/blog/" class="btn-primary">Read the blog</a>
      <a href="/projects/" class="btn-outline">See projects</a>
    </div>
  </div>
</BaseLayout>
