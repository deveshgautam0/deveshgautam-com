---
export interface Props { headings: { depth: number; slug: string; text: string }[]; depths?: [number, number]; }
const { headings, depths = [2, 3] as [number, number] } = Astro.props;
const top = headings.filter((h) => h.depth === depths[0]);
---
{headings.length ? (
  <nav class="toc" aria-label="Table of contents">
    <ol>
      {top.map((h2) => {
        const children = headings.filter((h) => h.depth === depths[1] && h.slug.startsWith(h2.slug + '-'));
        return (
          <li key={h2.slug}>
            <a href={`#${h2.slug}`}>{h2.text}</a>
            {children.length && (
              <ol>
                {children.map((c) => (
                  <li key={c.slug}><a href={`#${c.slug}`}>{c.text}</a></li>
                ))}
              </ol>
            )}
          </li>
        );
      })}
    </ol>
  </nav>
) : null}
<style>
  .toc { font-size: 15px; color: var(--text-muted); }
  .toc a { color: var(--text); text-decoration: none; }
  .toc a:hover { color: var(--accent); text-decoration: underline; }
  .toc ol { list-style: none; padding-left: 0; margin: 0; }
  .toc ol ol { padding-left: var(--space-4); }
  .toc li { margin-bottom: var(--space-2); }
  .toc li::marker { content: none; }
  .toc li::before { counter-increment: step; content: counters(step, ".") " "; font-weight: 700; color: var(--accent); margin-right: var(--space-2); }
  .toc ol ol li::before { counter-increment: substep; content: counters(step, ".") counters(substep, ".") " "; }
</style>
