---
export interface Props { post: { id: string; data: { title: string; description: string; date: Date; heroImage?: string; heroAlt: string }; }; }
const { post } = Astro.props;
const { data } = post;
const href = `/blog/${post.id}/`;
---
<article class="list-item">
  {data.heroImage && (
    <img src={data.heroImage} alt={data.heroAlt || data.title} class="thumb" loading="lazy" width="160" height="90" />
  )}
  <div class="list-item-body">
    <h4><a href={href}>{data.title}</a></h4>
    <p class="desc">{data.description}</p>
    <time style="font-size:14px;color:var(--text-muted);">{data.date.toLocaleDateString('en-US', { month: 'short', day: '2-digit', year: 'numeric' })}</time>
  </div>
</article>
<style>
  .list-item {
    display: flex;
    gap: var(--space-4);
    align-items: flex-start;
    padding: var(--space-4) 0;
    border-bottom: 1px solid var(--border);
  }
  .list-item:last-child { border-bottom: none; }
  .list-item img.thumb {
    width: 160px;
    height: 90px;
    border-radius: var(--radius-sm);
    object-fit: cover;
    flex-shrink: 0;
  }
  .list-item-body { flex: 1; min-width: 0; }
  .list-item h4 { margin: 0 0 var(--space-2) 0; font-size: 17px; line-height: 1.3; }
  .list-item h4 a { color: var(--text); }
  .list-item h4 a:hover { color: var(--accent); }
  .list-item .desc { margin: 0 0 var(--space-3) 0; font-size: 15px; color: var(--text-muted); display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden; }
  @media (max-width: 639px) {
    .list-item { flex-direction: column; align-items: stretch; }
    .list-item img.thumb { width: 100%; height: 180px; }
  }
</style>
