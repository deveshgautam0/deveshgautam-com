---
export interface Props { url: string; title: string; }
const { url, title } = Astro.props;
const encode = (s: string) => encodeURIComponent(s);
---
<p style="margin:0 0 var(--space-3) 0;font-size:14px;color:var(--text-muted);font-weight:600;">Share:</p>
<div class="shares" style="display:flex;gap:var(--space-2);flex-wrap:wrap;">
  <a href={`https://x.com/intent/post?url=${encode(url)}&text=${encode(title)}`} class="btn-outline btn-sm" target="_blank" rel="noopener" aria-label="Share on X">X</a>
  <a href={`https://www.facebook.com/sharer/sharer.php?u=${encode(url)}`} class="btn-outline btn-sm" target="_blank" rel="noopener" aria-label="Share on Facebook">Facebook</a>
  <a href={`https://reddit.com/submit?url=${encode(url)}&title=${encode(title)}`} class="btn-outline btn-sm" target="_blank" rel="noopener" aria-label="Share on Reddit">Reddit</a>
  <a href={`https://www.linkedin.com/sharing/share-offsite/?url=${encode(url)}`} class="btn-outline btn-sm" target="_blank" rel="noopener" aria-label="Share on LinkedIn">LinkedIn</a>
  <a href={`https://news.ycombinator.com/submit?url=${encode(url)}&t=${encode(title)}`} class="btn-outline btn-sm" target="_blank" rel="noopener" aria-label="Share on Y Combinator">Y Combinator</a>
</div>
