---
import Icon from './Icon.astro';
import site from '../data/site.json';
const built = new Date().toLocaleDateString('en-US', { month: 'short', day: 'numeric', year: 'numeric' });
const socials = [
  { key: 'email', label: 'Email', href: `mailto:${site.email}`, icon: 'mail', title: `${site.name} on Email` },
  { key: 'github', label: 'GitHub', href: site.github, icon: 'github', title: `${site.name} on Github` },
  { key: 'linkedin', label: 'LinkedIn', href: site.linkedin, icon: 'linkedin', title: `${site.name} on LinkedIn` },
  { key: 'twitter', label: 'Twitter/X', href: site.twitter, icon: 'x', title: `${site.name} on Twitter` },
  { key: 'youtube', label: 'YouTube', href: site.youtube, icon: 'youtube', title: `${site.name} on YouTube` },
  { key: 'instagram', label: 'Instagram', href: site.instagram, icon: 'instagram', title: `${site.name} on Instagram` },
].filter((s) => s.href);
---
<footer class="footer" role="contentinfo">
  <div class="footer-inner container">
    <div class="footer-info">
      <p class="footer-built">Last built: {built}</p>
    </div>
    <nav class="footer-social" aria-label="Social links">
      {socials.map((s) => (
        <a href={s.href} class="icon-btn" aria-label={s.title} title={s.title}>
          <Icon name={s.icon} size="18" />
        </a>
      ))}
      <a href="/api/feed.xml" class="icon-btn" aria-label="RSS Feed" title="RSS Feed">
        <Icon name="rss" size="18" />
      </a>
    </nav>
  </div>
</footer>
<style>
  .footer {
    border-top: 1px solid var(--border);
    margin-top: var(--space-10);
    padding: var(--space-8) 0;
    background-color: var(--bg);
  }
  .footer-inner {
    max-width: 1100px;
    margin: 0 auto;
    padding: 0 var(--space-4);
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    width: 100%;
    gap: var(--space-6);
  }
  @media (min-width: 768px) {
    .footer-inner { padding: 0 var(--space-6); }
  }
  .footer-info {
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
    text-align: left;
    margin-top: 0;
  }
  .footer-built {
    margin: 0;
    font-size: 14px;
    color: var(--text-muted);
  }
  .footer-design {
    margin: 0;
    font-size: 14px;
    color: var(--text-muted);
  }
  .footer-design a { color: var(--text); text-decoration: underline; }
  .footer-design a:hover { color: var(--accent); }
  .footer-social {
    display: flex;
    gap: var(--space-2);
    flex-wrap: wrap;
  }
  .footer-social .icon-btn {
    width: 40px;
    height: 40px;
    min-width: 40px;
    min-height: 40px;
    padding: 0;
    display: inline-flex;
    align-items: center;
    justify-content: center;
  }
</style>
